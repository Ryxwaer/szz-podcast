# Gemini Developer API key(s). Free tier works but has low per-minute/day limits,
# so you can supply several keys and the renderer rotates to the next one on a 429:
#   - comma-separated in one line:  GEMINI_API_KEY=key1,key2,key3
#   - or numbered:                  GEMINI_API_KEY_2=key2  (GEMINI_API_KEY_3, ...)
# May also live in the repo-root .env (this backend reads it as a fallback).
# Get keys at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
