#!/usr/bin/env bash
# Standalone launcher for the ElevenLabs renderer. Sets PYTHONPATH and runs the
# CLI from the local source tree (no install needed), mirroring ../gemini_speech/run.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$DIR/src${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m elspeech.cli "$@"
