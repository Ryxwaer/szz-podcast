# Global secrets for the backend-agnostic steps (R2 upload via wrangler).
# Cloudflare account that owns the R2 bucket (used by wrangler for uploads).
CLOUDFLARE_ACCOUNT_ID=0c4fe32bcbb1416fbcd20ea1af2762e9

# TTS API keys are normally kept in each backend's own .env, but every backend also
# reads THIS root .env as a fallback, so you may put them here instead:
#   ELEVENLABS_API_KEY                 (elevenlabs_speech)
#   GEMINI_API_KEY                     (gemini_speech; comma-separated or
#   GEMINI_API_KEY_2, ... to cycle several keys on a 429)
#   AZURE_SPEECH_KEY / AZURE_SPEECH_REGION   (azure_speech)
# A backend-local .env value overrides the one here.
